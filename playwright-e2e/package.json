{
  "name": "rust-fel-playwright-e2e",
  "private": true,
  "scripts": {
    "build:wasm": "wasm-pack build demo --target web --out-dir ../site/pkg",
    "serve": "http-server site -p 4173 -c-1 --silent",
    "test": "npm run build:wasm && playwright test",
    "test:headed": "npm run build:wasm && playwright test --ui",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "http-server": "^14.1.1"
  }
}
